---
layout: layouts/interior.njk
pageTitle: CaMP Lab
crumb: CaMP Lab
section: camp
permalink: /camp-lab/
barLogo: /assets/camp-logo.png
description: "The CaMP Lab — interdisciplinary research in cognition, morality, and philosophy."
---
<div class="wrap">

  <section class="hero-con" aria-label="Page heading">
    <span class="bardiag" aria-hidden="true"></span>
    <span class="barblk" aria-hidden="true"></span>
    <h1>CaMP LAB</h1>
    <p class="deck">The CaMP Lab supports interdisciplinary research at the intersection of philosophy and the cognitive and social sciences. Current work focuses on political polarization, cross-cultural moral psychology, consciousness, self-regulation, and moral responsibility.</p>
    <span class="stat"><span>Cognition · Morality · Philosophy</span></span>
  </section>

  <div class="sect-label"><span class="sq"></span><h2>Research supported by</h2><span class="rule"></span></div>
  <div class="funders">
    {% for f in funders %}
    {% if f.url %}<a class="funder" href="{{ f.url }}" aria-label="{{ f.name }}">{% else %}<div class="funder">{% endif %}
      {% if f.logo %}
        <img src="{{ f.logo }}" alt="{{ f.name }}">
      {% else %}
        <span class="wordmark">{{ f.name }}<span class="short">{{ f.short }}</span></span>
      {% endif %}
    {% if f.url %}</a>{% else %}</div>{% endif %}
    {% endfor %}
  </div>

  <div class="sect-label"><span class="sq"></span><h2>Current projects</h2><span class="rule"></span></div>
  <div class="projects">
    {% for pr in projects.current %}
    <div class="project">
      <div class="num">{{ loop.index | pad2 }}</div>
      <h3>{{ pr.title }}</h3>
      <p>{{ pr.blurb }}</p>
      {% if pr.credit %}<p class="credit">{{ pr.credit }}</p>{% endif %}
      <div class="yrs">{{ pr.years }} · {{ pr.funder }}</div>
    </div>
    {% endfor %}
  </div>

  <div class="sect-label"><span class="sq"></span><h2>Selected past projects</h2><span class="rule"></span></div>
  <div class="projects">
    {% for pr in projects.past %}
    <div class="project">
      <div class="num">{{ loop.index | pad2 }}</div>
      <h3>{{ pr.title }}</h3>
      <p>{{ pr.blurb }}</p>
      {% if pr.credit %}<p class="credit">{{ pr.credit }}</p>{% endif %}
      <div class="yrs">{{ pr.years }} · {{ pr.funder }}</div>
    </div>
    {% endfor %}
  </div>

  <p class="camp-earlier"><span>Earlier funded work</span> {{ projects.earlier }}</p>

</div>

      <div>
        <div class="ti">Neuroethics</div>
        <div class="meta">Fall 2026 · Readings, schedule, handouts, slides, and assignments</div>
      </div>
      <div class="term">Open course ↗</div>
    </a>
  </div>

  <div class="sect-label"><span class="sq"></span><h2>Selected syllabi</h2><span class="rule"></span></div>
  <div class="courses">
    {% for c in courses %}
    <a class="course course-link" href="{{ c.syllabus }}" target="_blank" rel="noopener">
      <div class="code">{{ c.code }}</div>
      <div>
        <div class="ti">{{ c.title }}</div>
        <div class="meta">{{ c.meta }}</div>
      </div>
      <div class="term">Syllabus · PDF ↗</div>
    </a>
    {% endfor %}
  </div>

  <p class="ph" style="margin:24px 2px 60px;">Representative syllabi from courses taught at Providence College.</p>

</div>
